{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:monorepos"],
  "timezone": "Europe/Istanbul",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Tüm devDependencies güncellemelerini tek PR'da grupla",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies"
    },
    {
      "description": "TypeScript major'ları elle: typescript-eslint TS'i <6.1 ile sınırlıyor",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "ESLint major'ları elle: plugin peer çakışmaları koordinasyon gerektiriyor",
      "matchPackageNames": ["eslint"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
