{
  "$schema": "https://www.schemastore.org/package",
  "name": "april",
  "version": "0.1.0",
  "description": "Amazing description!",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "is-ci || husky",
    "dev": "turbo run dev",
    "test": "vitest",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:build": "prettier --check ./packages && eslint ./packages",
    "format": "turbo run format",
    "format:build": "prettier --write ./packages && eslint --fix ./packages",
    "clean": "turbo run clean",
    "clean:root": "rm -rf node_modules .husky/_ .turbo pnpm-lock.yaml artifacts",
    "update": "pnpm --recursive update --interactive",
    "update:latest": "pnpm --recursive update --interactive --latest"
  },
  "keywords": [],
  "homepage": "https://github.com/playerberry/april",
  "funding": "https://github.com/playerberry/april?sponsor",
  "repository": {
    "type": "",
    "url": "https://github.com/playerberry/april.git"
  },
  "bugs": {
    "email": "bugs@playerberry.com",
    "url": "https://github.com/playerberry/april/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-angular": "^20.2.0",
    "@types/node": "^25.0.3",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.27.0"
}
