{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "april",
  "version": "0.1.0",
  "private": true,
  "description": "April — a strict, type-safe TypeScript monorepo (pnpm + Turborepo).",
  "keywords": [],
  "homepage": "https://github.com/yankikucuk/monorepo",
  "bugs": {
    "url": "https://github.com/yankikucuk/monorepo/issues",
    "email": "bugs@playerberry.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yankikucuk/monorepo.git"
  },
  "funding": "https://github.com/yankikucuk/monorepo?sponsor",
  "license": "Apache-2.0",
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "type": "module",
  "scripts": {
    "prepare": "is-ci || husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:root",
    "lint": "turbo run lint",
    "lint:build": "prettier --check . && eslint . --max-warnings=0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "manypkg": "manypkg check",
    "depcruise": "depcruise packages --config .dependency-cruiser.jsonc",
    "docs:api": "typedoc",
    "format": "turbo run format",
    "format:build": "prettier --write . && eslint --fix .",
    "sort:pkg": "node scripts/sort-package-json.mjs",
    "sort:pkg:check": "node scripts/sort-package-json.mjs --check",
    "clean": "turbo run clean",
    "clean:root": "rm -rf node_modules .husky/_ .turbo pnpm-lock.yaml",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "update": "pnpm --recursive update --interactive",
    "update:latest": "pnpm --recursive update --interactive --latest",
    "typecheck:root": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@april/eslint-config": "workspace:*",
    "@april/prettier-config": "workspace:*",
    "@april/tsconfig": "workspace:*",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jiti": "^2.7.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  }
}
