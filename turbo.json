{
  "$schema": "https://turborepo.com/schema.json",
  // Files that every task reads without declaring them as a dependency: ESLint
  // and Prettier resolve their configuration by walking up to the repository
  // root, and the shared configuration packages are consumed straight from
  // source (ADR 0004). Listing them here keeps the cache correct when a rule or
  // preset changes.
  "globalDependencies": [
    ".editorconfig",
    ".prettierignore",
    "eslint.config.ts",
    "prettier.config.ts",
    "packages/shared/eslint-config/src/**",
    "packages/shared/import-sort/src/**",
    "packages/shared/prettier-config/src/**",
    "packages/shared/tsconfig/*.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      // Every package compiles `src` only; docs, tests and benchmarks cannot
      // change the emitted output.
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!benchmarks/**", "!**/*.md", "!typedoc.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      // A package that imports another package's types needs its `dist/`
      // (only `@april/cyberflake` builds; the config packages ship sources).
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!benchmarks/**", "!**/*.md", "!typedoc.json"]
    },
    "lint": {
      // Changelogs are generated by Changesets and never linted.
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"]
    },
    "format": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
