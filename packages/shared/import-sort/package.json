{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@april/import-sort",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic import sorting for JavaScript and TypeScript: a host-agnostic sorting engine plus an ESLint rule (`import-sort/order`) with configurable groups, locale-aware comparison, asc/desc direction, per-import opt-outs, and a single autofix.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "import-sort",
    "sort-imports",
    "import-order",
    "typescript",
    "flat-config"
  ],
  "homepage": "https://github.com/yankikucuk/monorepo/tree/stage/packages/shared/import-sort#readme",
  "bugs": {
    "url": "https://github.com/yankikucuk/monorepo/issues",
    "email": "bugs@playerberry.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yankikucuk/monorepo.git",
    "directory": "packages/shared/import-sort"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check ./src ./tests && eslint ./src ./tests --max-warnings=0",
    "format": "prettier --write ./src ./tests && eslint --fix ./src ./tests",
    "clean": "rm -rf node_modules .turbo"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.69.0"
  },
  "devDependencies": {
    "@april/tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
