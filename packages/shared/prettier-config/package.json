{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@april/prettier-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Prettier configuration for the April monorepo.",
  "keywords": [
    "prettier",
    "prettier-config",
    "formatting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/playerberry/april.git",
    "directory": "packages/shared/prettier-config"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check ./src && eslint ./src --max-warnings=0",
    "format": "prettier --write ./src && eslint --fix ./src",
    "clean": "rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@april/tsconfig": "workspace:*",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
