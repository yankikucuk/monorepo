{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@april/cyberflake",
  "version": "1.0.0",
  "private": true,
  "description": "A high-performance, Snowflake-inspired distributed ID generator designed as a core infrastructure primitive for the April monorepo. Provides globally unique, monotonically ordered identifiers with clock-regression tolerance and deterministic test support.",
  "keywords": [
    "id-generator",
    "snowflake",
    "distributed-id",
    "unique-id",
    "bigint",
    "monotonic"
  ],
  "homepage": "https://github.com/yankikucuk/monorepo/tree/stage/packages/cyberflake#readme",
  "bugs": {
    "url": "https://github.com/yankikucuk/monorepo/issues",
    "email": "bugs@playerberry.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yankikucuk/monorepo.git",
    "directory": "packages/cyberflake"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check ./src && eslint ./src --max-warnings=0",
    "format": "prettier --write ./src && eslint --fix ./src",
    "bench": "NODE_OPTIONS=--expose-gc tsx benchmarks/generate.bench.ts && NODE_OPTIONS=--expose-gc tsx benchmarks/sameMs.bench.ts",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "devDependencies": {
    "@april/tsconfig": "workspace:*",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
